# @nlightn22/event-contracts (packages/plugins/erp-integration) is published to GitHub Packages,
# not the public npm registry — see search-platform#63/#64.
#
# pnpm deliberately does NOT expand ${GITHUB_PACKAGES_TOKEN} from this committed, project-level
# .npmrc for the auth token line below (a committed file could otherwise leak a token template to
# an attacker-controlled registry) — this file only sets which registry to use for the @nlightn22
# scope. To actually install, each machine (local dev, CI) needs its own auth token set at a
# pnpm-trusted location, once:
#
#   pnpm config set "//npm.pkg.github.com/:_authToken" <a classic PAT with read:packages scope>
#
# (or the equivalent in a user-level ~/.npmrc). Without this, `pnpm install` still succeeds if the
# package is already in the local pnpm content-addressable store from a prior install, but fails
# on a genuinely fresh machine/CI runner.
@nlightn22:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_PACKAGES_TOKEN}
