INSTANCE_TYPE=branch
INSTANCE_ID=branch-a

PORT=3001
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=mivend_branch

RABBITMQ_URL=amqp://mivend:mivend@localhost:5672

SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin

# Issue #119: MANAGER_PUBLIC_URL intentionally left unset here — a branch instance has no manager
# portal/external access of its own yet (docs/environments.md, "Reaching a contour from outside
# this box"). Administrator lifecycle emails on a branch instance will carry a broken
# password-reset link until a branch ever gets its own manager portal.

# Mounts the legacy direct-REST ERP intake (/erp/import/*); off by default.
ERP_IMPORT_ENABLED=true
# Token for /erp/import/*, min 16 chars; seed scripts and e2e send it.
ERP_IMPORT_TOKEN=dev-import-token-change-me-0000

# Local-only REST surfaces (closed by default; production leaves all of these unset).
# Serves written emails (reset tokens) at /mailbox; local only.
EMAIL_DEV_MAILBOX_ENABLED=true
# Serves Swagger at /api-docs; local only.
API_DOCS_ENABLED=true
# Mounts /erp/callback/*, /erp/orders/*/status, /erp/kafka-status; local/e2e only.
ERP_CALLBACK_ENABLED=true
# X-Api-Key those routes require, min 16 chars; e2e and seed-customer-detail send it.
ERP_CALLBACK_API_KEY=dev-callback-key-change-me-0000

# Signs the auth cookie; must be stable across restarts and identical on every process.
COOKIE_SECRET=change-me-in-production
# Server-side session lifetime, active sessions per account type and the daily reset (docs/environments.md).
SESSION_DURATION=30d
SESSION_MAX_ACTIVE_CUSTOMER=20
SESSION_MAX_ACTIVE_STAFF=20
# true ends every session once a day at SESSION_DAILY_RESET_HOUR (0-23) in the IANA zone below; off outside production.
SESSION_DAILY_RESET_ENABLED=false
SESSION_DAILY_RESET_HOUR=3
SESSION_DAILY_RESET_TIME_ZONE=UTC
# Days a known sign-in device is remembered after its last use.
SESSION_KNOWN_DEVICE_RETENTION_DAYS=400
# Second factor (#279): true makes a one-time authenticator code mandatory at every sign-in for every account.
# Leave false/empty outside production. Optional TWO_FACTOR_ENCRYPTION_KEY (64 hex characters) replaces
# the key otherwise derived from COOKIE_SECRET (docs/two-factor.md).
TWO_FACTOR_REQUIRED=false
# TWO_FACTOR_ENCRYPTION_KEY=
# Sign-in protection (#278): off on local contours so tests and e2e can sign in repeatedly; production turns it on.
# Thresholds, CAPTCHA keys and the breached-password check: docs/deployment.md "Sign-in protection".
SIGN_IN_THROTTLE_ENABLED=false
PASSWORD_BREACH_CHECK_ENABLED=false
# Comma-separated origins allowed to call the API cross-origin with credentials; empty = no CORS.
CORS_ALLOWED_ORIGINS=
