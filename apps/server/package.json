        "@mivend/plugin-customer-pricing": "workspace:*",
        "@mivend/plugin-documents": "workspace:*",
        "@mivend/plugin-erp-import": "workspace:*",
        "@mivend/plugin-erp-integration": "workspace:*",
        "@mivend/plugin-erp-order": "workspace:*",
        "@mivend/plugin-moq": "workspace:*",
        "@mivend/plugin-notification": "workspace:*",
        "@mivend/plugin-popular-products": "workspace:*",
        "@mivend/plugin-price-entry": "workspace:*",
        "@mivend/plugin-reservation": "workspace:*",
