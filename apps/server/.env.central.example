INSTANCE_TYPE=central
INSTANCE_ID=central

PORT=3000
ADMIN_UI_PORT=3002
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=mivend_central

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

RABBITMQ_URL=amqp://mivend:mivend@localhost:5672

SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin

ERP_IMPORT_TOKEN=dev-token

# erp-integration plugin (issue #62) — optional. Left unset, ErpIntegrationPlugin falls back to
# localhost:9094/localhost:8081 (harmless no-op in dev: the outbox worker only calls out to Kafka
# when there's a pending row, and this repo's docker-compose has no local Kafka service).
#INTEGRATION_KAFKA_BROKERS=is.komponent-m.ru:9094
#INTEGRATION_KAFKA_CLIENT_ID=mivend-central-hub
#INTEGRATION_KAFKA_SASL_USERNAME=mivend-hub
#INTEGRATION_KAFKA_SASL_PASSWORD=
#INTEGRATION_KAFKA_TOPIC=mivend.orders.events.v1.order-submitted
#INTEGRATION_KAFKA_CA_PATH=../../../infrastructure/kafka-tls/is-komponent-m-ca.crt
#INTEGRATION_SCHEMA_REGISTRY_URL=https://is.komponent-m.ru/schema-registry
