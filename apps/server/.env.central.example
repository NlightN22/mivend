INSTANCE_TYPE=central
INSTANCE_ID=central

PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=mivend_central

RABBITMQ_URL=amqp://mivend:mivend@localhost:5672
ELASTICSEARCH_HOST=http://localhost:9201

SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin

# Issue #119: base URL of the manager portal, used to build password-reset/account-activation
# links sent by email. Per-contour — see docs/environments.md's port table (local: manager on
# external port 8005 behind nginx).
MANAGER_PUBLIC_URL=https://devhost.example.com:8005

# Mounts the legacy direct-REST ERP intake (/erp/import/*); off by default.
ERP_IMPORT_ENABLED=true
# Token for /erp/import/*, min 16 chars; seed scripts and e2e send it.
ERP_IMPORT_TOKEN=dev-import-token-change-me-0000

# Local-only REST surfaces (closed by default; production leaves all of these unset).
# Serves written emails (reset tokens) at /mailbox; local only.
EMAIL_DEV_MAILBOX_ENABLED=true
# Serves Swagger at /api-docs; local only.
API_DOCS_ENABLED=true
# Mounts /erp/callback/*, /erp/orders/*/status, /erp/kafka-status; local/e2e only.
ERP_CALLBACK_ENABLED=true
# X-Api-Key those routes require, min 16 chars; e2e and seed-customer-detail send it.
ERP_CALLBACK_API_KEY=dev-callback-key-change-me-0000

# erp-integration plugin (issue #62/#68) — local contour. INTEGRATION_KAFKA_ENABLED must stay
# false (or unset) here: this is the default `make dev` target and must never reach a real
# Integration Service broker — only synthetic data via `make seed-all` (erp-import). To validate
# the real Kafka contract, use `make dev-staging-integration`
# (apps/server/.env.central.staging-integration(.example)) instead of setting real credentials here. See
# docs/environments.md.
INTEGRATION_KAFKA_ENABLED=false
#INTEGRATION_KAFKA_BROKERS=integration.example.com:9094
#INTEGRATION_KAFKA_CLIENT_ID=mivend-central-hub-local
#INTEGRATION_KAFKA_SASL_USERNAME=mivend-hub
#INTEGRATION_KAFKA_SASL_PASSWORD=
#INTEGRATION_KAFKA_CA_PATH=../../../infrastructure/kafka-tls/integration-ca.crt
#INTEGRATION_SCHEMA_REGISTRY_URL=https://integration.example.com/schema-registry

# search plugin (issue #69) — local contour. SEARCH_BACKEND must stay "internal" (or unset) here:
# this is the default `make dev` target and keeps using ElasticsearchPlugin against local
# Elasticsearch. SEARCH_SERVICE_URL is only read when SEARCH_BACKEND=external — see
# docs/environments.md.
SEARCH_BACKEND=internal

# Checkout payment methods (issue #180). The stub online provider exists on the local contour only.
ONLINE_PAYMENT_STUB_ENABLED=true
# Set to false to drop the bank-invoice (offline-terms) payment method.
# OFFLINE_TERMS_ENABLED=true

# Signs the auth cookie; must be stable across restarts and identical on every process.
COOKIE_SECRET=change-me-in-production
# Server-side session lifetime and active sessions per user (docs/environments.md).
SESSION_DURATION=30d
SESSION_MAX_ACTIVE_PER_USER=20

# Asset storage (issue #181): S3-compatible, Garage from docker-compose.dev.yml. Create the
# bucket/key with infrastructure/scripts/garage-init.sh; unset S3_ENDPOINT = local directory.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=mivend-assets-local
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
