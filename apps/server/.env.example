# Determines instance behaviour: 'central' (hub) or 'branch' (location)
INSTANCE_TYPE=branch
INSTANCE_ID=branch-a

PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=mivend_branch

REDIS_HOST=localhost
REDIS_PORT=6379

# Required for branch instances only
RABBITMQ_URL=amqp://mivend:mivend@localhost:5672

SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin
DASHBOARD_CORS_ORIGINS=http://localhost:5175
