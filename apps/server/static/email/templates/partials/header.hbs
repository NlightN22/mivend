<mjml>
    <mj-head>
        <mj-title>{{ title }}</mj-title>
        <mj-style inline="inline">
            h3 {
                font-size: 18px;
                color: #555;
                font-weight: normal;
            }
        </mj-style>
    </mj-head>

    <mj-body>
        <mj-section background-color="#f0f0f0">
            <mj-column>
                <mj-text>
                    {{#if logoUrl}}<img src="{{ logoUrl }}" alt="" width="40" height="40" style="vertical-align: middle; margin-right: 12px;" />{{/if}}<span style="vertical-align: middle;">{{ siteName }}</span>
                </mj-text>
            </mj-column>
        </mj-section>
