{{> header title="Recover your authenticator" }}

<mj-section background-color="#fafafa">
    <mj-column>
        <mj-text color="#525252">
            Someone asked to recover access to your account after losing the authenticator device. The link below is single-use and expires soon; you will need your account password.
        </mj-text>

        <mj-button font-family="Helvetica"
                   background-color="#f45e43"
                   color="white"
                   href="{{ twoFactorRecoveryUrl }}?token={{ twoFactorRecoveryToken }}">
            Recover access
        </mj-button>

        <mj-text color="#525252">
            If you did not make this request, ignore this email: nothing has been changed on your account.
        </mj-text>

    </mj-column>
</mj-section>

{{> footer defaultFooter="This is an automated message, please do not reply." }}
