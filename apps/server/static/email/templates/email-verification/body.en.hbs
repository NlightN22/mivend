{{> header title="Verify your email address" }}

<mj-section background-color="#fafafa">
    <mj-column>
        <mj-text color="#525252">
            Thank you for creating an account. Click the button below to verify this email address and complete the registration:
        </mj-text>

        <mj-button font-family="Helvetica"
                   background-color="#f45e43"
                   color="white"
                   href="{{ verifyEmailAddressUrl }}?token={{ verificationToken }}">
            Verify email
        </mj-button>
    </mj-column>
</mj-section>

{{> footer defaultFooter="This is an automated message, please do not reply." }}
