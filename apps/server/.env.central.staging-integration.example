INSTANCE_TYPE=central
INSTANCE_ID=central-staging-integration

PORT=3010
NODE_ENV=development

# Deliberately separate database from the local contour (.env.central) — see
# docs/environments.md.
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=mivend_central_staging_integration

RABBITMQ_URL=amqp://mivend:mivend@localhost:5672

SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin

# Issue #119: base URL of the manager portal, used to build password-reset/account-activation
# links sent by email. Per-contour — see docs/environments.md's port table (staging-integration:
# manager on external port 8015 behind nginx).
MANAGER_PUBLIC_URL=https://devhost.example.com:8015
# Storefront origin where a manager's acting session opens (issued with the ticket); required for acting sessions.
STOREFRONT_PUBLIC_URL=https://devhost.example.com:8014

# erp-import (legacy direct-REST ERP intake) is OFF here — this contour's whole point is real
# Kafka/Integration Service data only, DB otherwise empty (issue #68). Local/branch default to
# true — see .env.central.example.
# Closed by default; the mailbox/Swagger/ERP callback flags are deliberately unset here (docs/environments.md).
ERP_IMPORT_ENABLED=false

# erp-integration plugin (issue #62/#68) — staging-integration contour, the only contour that
# talks to Integration Service's real Kafka. clientId/groupId are suffixed "-staging-integration"
# so a misconfiguration can never silently merge consumer offsets/dedup state with local/prod.
# See docs/environments.md.
INTEGRATION_KAFKA_ENABLED=true
# #144: raw ERP VAT code made the default TaxCategory when none exists yet.
INTEGRATION_DEFAULT_VAT_CODE=НДС20
INTEGRATION_KAFKA_BROKERS=integration.example.com:9094
INTEGRATION_KAFKA_CLIENT_ID=mivend-central-hub-staging-integration
INTEGRATION_KAFKA_CONSUMER_CLIENT_ID=mivend-central-hub-staging-integration
INTEGRATION_KAFKA_CONSUMER_GROUP_ID=mivend-central-hub-staging-integration
INTEGRATION_KAFKA_SASL_USERNAME=
INTEGRATION_KAFKA_SASL_PASSWORD=
# Absolute path, not relative — vendure-config.ts resolves this via path.resolve(__dirname, ...),
# and __dirname differs for every consumer that loads this config (the real server vs. e.g.
# packages/dashboard's standalone compiler, which copies/transpiles it into its own temp dir).
INTEGRATION_KAFKA_CA_PATH=/opt/mivend/infrastructure/kafka-tls/integration-ca.crt
INTEGRATION_SCHEMA_REGISTRY_URL=https://integration.example.com/schema-registry

# search plugin (issue #69) — staging-integration contour, the only contour (besides production)
# that talks to the real search-service instead of local Elasticsearch. SEARCH_SERVICE_URL and
# SEARCH_SERVICE_API_KEY (sent as X-Api-Key, issued by the search service's api-key:create) are
# required at bootstrap whenever SEARCH_BACKEND=external. See docs/environments.md.
SEARCH_BACKEND=external
SEARCH_SERVICE_URL=https://search.example.com
SEARCH_SERVICE_API_KEY=
SEARCH_END_USER_ID_SECRET=

# erp-integration reconciliation summary API (issue #84) — GET /api/reconciliation/v1/summary
# on the Integration Service host.
INTEGRATION_SERVICE_API_KEY=
INTEGRATION_SERVICE_BASE_URL=https://integration.example.com
# Required for resync replay; no default.
INTEGRATION_RESYNC_SOURCE_SYSTEM=source-system-1
# Optional read:packages token; lets integration-health show the latest published event-contracts version.
EVENT_CONTRACTS_REGISTRY_TOKEN=
DEFAULT_PRICE_TYPE_CODE=roznichnaya
# Comma-separated branches created at bootstrap; the first becomes the default branch.
BOOTSTRAP_BRANCH_NAMES=Branch A,Branch B

# Signs the auth cookie; must be stable across restarts and identical on every process.
COOKIE_SECRET=change-me-in-production
# Server-side session lifetime, active sessions per account type and the daily reset (docs/environments.md).
SESSION_DURATION=30d
SESSION_MAX_ACTIVE_CUSTOMER=20
SESSION_MAX_ACTIVE_STAFF=20
# true ends every session once a day at SESSION_DAILY_RESET_HOUR (0-23) in the process time zone (TZ); off outside production.
SESSION_DAILY_RESET_ENABLED=false
SESSION_DAILY_RESET_HOUR=3
# Days a known sign-in device is remembered after its last use.
SESSION_KNOWN_DEVICE_RETENTION_DAYS=400
# Second factor (#279): true makes a one-time authenticator code mandatory at every sign-in for every account.
# Leave false/empty outside production. Optional TWO_FACTOR_ENCRYPTION_KEY (64 hex characters) replaces
# the key otherwise derived from COOKIE_SECRET (docs/two-factor.md).
TWO_FACTOR_REQUIRED=false
# TWO_FACTOR_ENCRYPTION_KEY=
# Optional OpenID Connect sign-in for staff (docs/deployment.md "Staff sign-in through an OpenID Connect provider").
# Set all four or none; unset disables the button.
# OIDC_ISSUER_URL=https://idp.example.com/realms/staff
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://manager.example.com/oidc/callback
# Sign-in protection (#278): off on local contours so tests and e2e can sign in repeatedly; production turns it on.
# Thresholds, CAPTCHA keys and the breached-password check: docs/deployment.md "Sign-in protection".
SIGN_IN_THROTTLE_ENABLED=false
PASSWORD_BREACH_CHECK_ENABLED=false
# Comma-separated origins allowed to call the API cross-origin with credentials; empty = no CORS.
CORS_ALLOWED_ORIGINS=

# Asset storage (issue #181): S3-compatible, Garage from docker-compose.dev.yml. Create the
# bucket/key with infrastructure/scripts/garage-init.sh; unset S3_ENDPOINT = local directory.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=mivend-assets-local
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional address suggestions (see docs/environments.md)
ADDRESS_SUGGEST_URL=
ADDRESS_SUGGEST_API_KEY=
