# Copy to .env.local and fill in values
# .env.local is gitignored — never commit real secrets

# GitHub PAT with Actions read/write + Workflows read/write for this repo
GITHUB_TOKEN=github_pat_...

# 3-digit code identifying this instance (hub or one branch) in every document number
# NumberingPlugin issues (see docs/identifiers.md). Must be exactly 3 digits.
# INSTANCE_NUMBER_CODE=100

# Only set this if `make test-int` on your machine fails with
# "password authentication failed" against the test postgres containers — it usually means
# port 5432 is already taken by an unrelated postgres on your host, and
# docker-postgres-central-1/-branch-1 got mapped to different host ports instead
# (check with `docker ps` — this repo's Makefile maps them to 5434/5433 by default).
# TEST_DB_PORT=5434
