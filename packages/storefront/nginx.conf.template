server {
    # Defaults to 80 (the real compose deployment's container-internal port, mapped externally
    # via docker-compose.yml's ports:). Overridden to a fixed port (e.g. 18024) only by the
    # `make preview-up` --network host mode, which needs the container to listen on a real host
    # port directly (see docs/environments.md's "prod-preview" contour).
    listen ${LISTEN_PORT};
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # Vite's build output uses content-hashed filenames (index-<hash>.js) — a new deploy always
    # produces a new URL, so these can be cached forever with no revalidation. Without this, the
    # browser re-sends a conditional request for every one of these files on every visit, each
    # paying a full round trip over a real network — confirmed as a real, measurable slowdown for
    # a remote client (issue #115's own benchmark run, ~15 files × ~150ms of pure 304-revalidation
    # RTT over a VPN connection, on top of everything else).
    location /_app/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA fallback — every non-file route resolves client-side via vue-router. index.html itself
    # must never be cached (it's the one file whose content changes on every deploy without a
    # new URL) — nginx's default (no cache headers here) already means "revalidate every time".
    location / {
        try_files $uri $uri/ /index.html;
    }

    location /shop-api {
        proxy_pass ${API_TARGET};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Without this, nginx proxies to the upstream over HTTP/1.0 (its own default for
        # proxy_pass), which opens a brand-new TCP connection per request instead of reusing one
        # — a real, measurable extra cost per shop-api call, on top of the real network RTT a
        # remote client already pays (issue #115's own benchmark run).
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # WS subscriptions transport — see apps/server/src/subscriptions.ts's
    # mountNotificationSubscriptions('/shop-api-subscriptions').
    location /shop-api-subscriptions {
        proxy_pass ${API_TARGET};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    # Vendure's own assetUrlPrefix — product images, never this app's own built JS/CSS (that
    # lives under /_app, see vite.config.ts's build.assetsDir, issue #115).
    location /assets {
        proxy_pass ${API_TARGET};
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # REST API docs (issue #28).
    location /api-docs {
        proxy_pass ${API_TARGET};
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
}
