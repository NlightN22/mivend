server {
    # Defaults to 80 (the real compose deployment's container-internal port, mapped externally
    # via docker-compose.yml's ports:). Overridden to a fixed port (e.g. 18025/18026) only by the
    # `make preview-up` --network host mode, which needs the container to listen on a real host
    # port directly (see docs/environments.md's "prod-preview" contour).
    listen ${LISTEN_PORT};
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # Vite's build output uses content-hashed filenames — cache forever, no revalidation. See
    # packages/storefront/nginx.conf.template for the full explanation (issue #115).
    location /_app/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA fallback — every non-file route resolves client-side.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location /admin-api {
        proxy_pass ${API_TARGET};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    location /admin-api-subscriptions {
        proxy_pass ${API_TARGET};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    # Vendure's own assetUrlPrefix — product images, never this app's own built JS/CSS.
    location /assets {
        proxy_pass ${API_TARGET};
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
}
