# Vars consumed by docker-compose.yml (make prod-up). Copy to .env next to that file, or export
# these in whatever deploy pipeline runs `make prod-up`.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mivend

# Issue #120 follow-up: Postgres collation is fixed at CREATE DATABASE time and cannot be changed
# in place — a missing/wrong locale here silently breaks Cyrillic text sorting with no error
# until someone notices broken UI ordering. No default: compose refuses to start without this,
# and the server/worker processes refuse to boot if the database's actual locale doesn't match.
# See docs/environments.md.
DB_ICU_LOCALE=ru-RU

INSTANCE_TYPE=branch
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me

RABBITMQ_USER=mivend
RABBITMQ_PASS=change-me

IMAGE_TAG=latest
