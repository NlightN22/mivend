# Vars consumed by docker-compose.yml (make prod-up). Copy to .env next to that file, or export
# these in whatever deploy pipeline runs `make prod-up`.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mivend

# Issue #140: fixed at CREATE DATABASE time, no default — a wrong locale breaks Cyrillic sorting.
# See docs/environments.md's "Database locale" section.
DB_ICU_LOCALE=ru-RU

INSTANCE_TYPE=branch
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me

RABBITMQ_USER=mivend
RABBITMQ_PASS=change-me

IMAGE_TAG=latest
