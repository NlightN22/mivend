# Copy to infrastructure/docker/.env.production (git-ignored). `make prod-up` reads it.
# Required = no default, the stack refuses to start without it. Never commit real values.

# ── Required ─────────────────────────────────────────────────────────────────
# A published version (the publish workflow pushes v<package version> and sha-<commit>).
IMAGE_TAG=v0.0.1
# Optional per-frontend pins for a partial release; empty = follow IMAGE_TAG. Server, workers and migrate always use IMAGE_TAG.
STOREFRONT_IMAGE_TAG=
MANAGER_IMAGE_TAG=
DASHBOARD_IMAGE_TAG=

# Passwords: hex or alphanumeric only (`openssl rand -hex 16`); RABBITMQ_PASS goes into a URL.
POSTGRES_USER=mivend
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mivend
# Fixed at CREATE DATABASE time; a wrong value breaks Cyrillic sorting (docs/environments.md).
DB_ICU_LOCALE=ru-RU

INSTANCE_TYPE=central          # central | branch
INSTANCE_ID=central            # unique per instance, e.g. branch-a
# Exactly 3 digits, unique per instance; prefixes document numbers.
INSTANCE_NUMBER_CODE=001

SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=change-me
# Same for every process; `openssl rand -hex 32`. A value starting with change-me is refused.
COOKIE_SECRET=change-me
# Production sets this to true: every sign-in needs a one-time authenticator code (docs/two-factor.md).
TWO_FACTOR_REQUIRED=true
# Optional, 64 hex characters (`openssl rand -hex 32`); unset derives the factor-encryption key from COOKIE_SECRET.
TWO_FACTOR_ENCRYPTION_KEY=
# Optional OpenID Connect sign-in for staff (docs/deployment.md "Staff sign-in through an OpenID Connect provider").
# Set all four or none; unset disables the button.
# OIDC_ISSUER_URL=https://idp.example.com/realms/staff
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://manager.example.com/oidc/callback
# Sessions (docs/environments.md): at most 2 per customer and 3 per staff account (a new sign-in ends the oldest),
# and every session ends daily at the reset hour in the business time zone (IANA name; the release owner sets it).
# Process time zone of every app container (default UTC). Drives the daily session reset; data columns ignore it.
# TZ=UTC
SESSION_MAX_ACTIVE_CUSTOMER=2
SESSION_MAX_ACTIVE_STAFF=3
SESSION_DAILY_RESET_ENABLED=true
SESSION_DAILY_RESET_HOUR=3
# Days a known sign-in device is remembered after its last use.
SESSION_KNOWN_DEVICE_RETENTION_DAYS=400

# Sign-in protection (#278), docs/deployment.md "Sign-in protection". Optional values show their defaults.
SIGN_IN_THROTTLE_ENABLED=true
# SIGN_IN_THROTTLE_LOGIN_IP_THRESHOLD=5
# SIGN_IN_THROTTLE_LOGIN_THRESHOLD=50
# SIGN_IN_THROTTLE_BASE_LOCK_SECONDS=30
# SIGN_IN_THROTTLE_MAX_LOCK_SECONDS=900
# SIGN_IN_THROTTLE_RESET_AFTER_SECONDS=3600
# SIGN_IN_TRUSTED_PROXY_HOPS=2
# SIGN_IN_CAPTCHA_AFTER_FAILURES=3
# CAPTCHA after the failures above: CAPTCHA_PROVIDER=widget needs all five values below (placeholders, take them from
# the provider's dashboard); empty CAPTCHA_PROVIDER keeps it off.
CAPTCHA_PROVIDER=
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
CAPTCHA_SCRIPT_URL=https://captcha.example.com/widget.js
CAPTCHA_VERIFY_URL=https://captcha.example.com/verify
CAPTCHA_WIDGET_GLOBAL=captchaWidget
PASSWORD_BREACH_CHECK_ENABLED=true
# Required when the check is on: base URL of a k-anonymity range service (GET <url>/range/<5 hex characters>).
PASSWORD_BREACH_API_URL=https://breach-range.example.com
# PASSWORD_BREACH_TIMEOUT_MS=3000

RABBITMQ_USER=mivend
RABBITMQ_PASS=change-me

# internal = Elasticsearch in this stack (needs COMPOSE_PROFILES=internal-search); external = search service.
SEARCH_BACKEND=internal
COMPOSE_PROFILES=internal-search

# Email: smtp sends through an authenticated SMTP server; file writes mails to disk (a contour that sends none).
# EMAIL_SMTP_SECURE: starttls (submission, e.g. 2587) or tls (implicit TLS, e.g. 2465). Prefer a hex or alphanumeric password.
EMAIL_TRANSPORT=smtp
EMAIL_SMTP_HOST=smtp.example.org
EMAIL_SMTP_PORT=2587
EMAIL_SMTP_SECURE=starttls
EMAIL_SMTP_USER=no-reply@example.org
EMAIL_SMTP_PASSWORD=change-me
EMAIL_FROM_ADDRESS=no-reply@example.org

# Site identity: SITE_NAME is the mail sender name and the storefront/manager page title (required with smtp in production;
# no quotes, line breaks or < > & $ ; \). SITE_FAVICON_URL is an absolute URL or a /assets/... path; empty or invalid keeps the built-in icon.
SITE_NAME="Site A"
# SITE_FAVICON_URL=https://example.org/favicon.png
# Mail language when the request names none (en or ru; unset means en, anything else fails boot). Set it explicitly in production.
SITE_DEFAULT_LANGUAGE=en
# Optional mail footer line (no double quote, line break or < > $ ; { } \); unset uses a generic per-language text.
# EMAIL_FOOTER_TEXT="Site A, example.org"

# Object storage (garage). Key id: GK + 24 hex; secret and rpc secret: 64 hex (`openssl rand -hex 32`).
GARAGE_RPC_SECRET=change-me
S3_BUCKET=mivend-assets
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me

# ── Optional (defaults shown) ────────────────────────────────────────────────
BOOTSTRAP_BRANCH_NAMES=Main
# Comma-separated origins allowed to call the API cross-origin with credentials; leave empty (frontends proxy the API).
CORS_ALLOWED_ORIGINS=
# Public URL of the manager portal, used in password-reset links.
MANAGER_PUBLIC_URL=
# Public URL of the storefront, used in customer password-reset links. Required in production with EMAIL_TRANSPORT=smtp.
STOREFRONT_PUBLIC_URL=

# internal = Elasticsearch; external = search service (then set the two vars below).
SEARCH_SERVICE_URL=
SEARCH_SERVICE_API_KEY=
SEARCH_END_USER_ID_SECRET=
ES_HEAP=512m

# Host bindings; loopback by default, a public entry point (TLS) goes in front.
SERVER_BIND_ADDRESS=127.0.0.1
STOREFRONT_BIND_ADDRESS=127.0.0.1
MANAGER_BIND_ADDRESS=127.0.0.1
DASHBOARD_BIND_ADDRESS=127.0.0.1
SERVER_PORT=3000
STOREFRONT_PORT=8004
MANAGER_PORT=8005
DASHBOARD_PORT=8006
# Peers allowed to set the client address (X-Real-IP) for the portal containers' rate limits; the docker bridge range by default.
TRUSTED_PROXY_CIDR=172.16.0.0/12

SERVER_MEM_LIMIT=2g
WORKER_MEM_LIMIT=2g
WORKER_EMAIL_MEM_LIMIT=1g
# Postgres sizing for a dedicated 16 GB / 8 core SSD host (see docs/deployment.md "Postgres tuning"):
# shared_buffers about 1/3 of the container limit, effective_cache_size about half the host RAM.
POSTGRES_MEM_LIMIT=6g
POSTGRES_SHM_SIZE=1g
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_EFFECTIVE_CACHE_SIZE=5GB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAINTENANCE_WORK_MEM=512MB
POSTGRES_MAX_WAL_SIZE=4GB

# ── Nightly database maintenance (pg-maintenance service, docs/deployment.md) ───
MAINTENANCE_CRON=0 1 * * *
# Tables to VACUUM FULL after the nightly pass; empty normally, set for one night after a mass delete.
MAINTENANCE_FULL_TABLES=

# ── ERP exchange (central only; off keeps the instance isolated) ─────────────
INTEGRATION_KAFKA_ENABLED=false
# When true, the client/consumer ids below are required (no safe default).
INTEGRATION_KAFKA_BROKERS=localhost:9094
INTEGRATION_KAFKA_CLIENT_ID=
INTEGRATION_KAFKA_CONSUMER_CLIENT_ID=
INTEGRATION_KAFKA_CONSUMER_GROUP_ID=
INTEGRATION_KAFKA_SASL_USERNAME=
INTEGRATION_KAFKA_SASL_PASSWORD=
# Host directory with the CA file, mounted read-only at /run/kafka-tls; the path below is inside the container.
KAFKA_TLS_DIR=../kafka-tls
INTEGRATION_KAFKA_CA_PATH=
INTEGRATION_SCHEMA_REGISTRY_URL=
INTEGRATION_SERVICE_BASE_URL=
INTEGRATION_SERVICE_API_KEY=
INTEGRATION_RESYNC_SOURCE_SYSTEM=
# Tax category for products whose ERP VAT code is empty or retired; becomes the default TaxCategory.
INTEGRATION_DEFAULT_VAT_CODE=

# Map location picker (docs/environments.md, Geo provider). Keys and the contact string stay out of the repository.
GEO_PROVIDERS=provider-a,provider-b,open
GEO_DEFAULT_PROVIDER=provider-b
GEO_DEFAULT_ZOOM=10
# Map start view when a point has no coordinates yet.
GEO_DEFAULT_CENTER_LAT=
GEO_DEFAULT_CENTER_LNG=
# Origin-restricted keys of the map scripts (returned to the browser by geoConfig).
GEO_PROVIDER_A_BROWSER_KEY=
GEO_PROVIDER_B_BROWSER_KEY=
# Optional: provider-a type-ahead and coordinate lookup keys, its script host suffix, an own open geocoder URL.
GEO_PROVIDER_A_BROWSER_SUGGEST_KEY=
GEO_PROVIDER_A_BROWSER_SEARCH_KEY=
GEO_PROVIDER_A_BROWSER_HOST=
GEO_OPEN_URL=
# Contact string the public open geocoder requires in its User-Agent.
GEO_PROVIDER_USER_AGENT=
